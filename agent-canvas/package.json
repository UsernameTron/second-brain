{
  "name": "agent-canvas",
  "private": true,
  "version": "0.1.0",
  "description": "Agent Canvas Workspace — shared multi-agent visual canvas for cloudtechgurus.com",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "DEV_AUTH=1 node server/index.js",
    "seed": "node server/seed.js",
    "test": "node --test \"test/*.test.js\"",
    "test:frontend": "npm test --prefix frontend",
    "verify": "npm test && npm run test:frontend && npm run build --prefix frontend && bash -n deploy/deploy.sh && bash deploy/deploy.sh --selftest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.0",
    "@anthropic-ai/vertex-sdk": "^0.19.1",
    "@google/genai": "^2.16.0",
    "exceljs": "4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "google-auth-library": "^11.0.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "1.12.1",
    "pdfjs-dist": "5.4.296",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
